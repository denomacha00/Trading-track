# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Env & secrets
.env
*.env
!env.example

# Database
*.db
*.sqlite
*.sqlite3
# SQLite WAL/SHM sidecars (created at runtime in WAL mode; runtime data, never commit)
*.db-wal
*.db-shm
*.db-journal

# Node / frontend
node_modules/
dist/
.vite/
*.tsbuildinfo

# Built dashboard served by the backend (generated: Dockerfile copies frontend/dist here;
# locally `cp -r frontend/dist backend/static`). Never commit a stale bundle.
backend/static/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
.techword/

# Logs
*.log
logs/

# Scratch / temp
COMMIT_MSG.tmp
backend/_alembic_tmp/
*_tmp.db

# Local dev-only helpers (not shipped) + local tooling config
backend/_preview_launch.py
backend/app/_smoke.py
.claude/
